# SUPABASE CONFIGURATION (lấy ở Supabase > Project Settings > API)
# KHÔNG commit file .env chứa khóa thật.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Khóa server (service role) - bắt buộc vì các bảng bật RLS
SUPABASE_SECRET_KEY=sb_secret_...

# SEPAY CONFIGURATION
SEPAY_ACCOUNT_NUMBER=your-account-number
SEPAY_BANK_CODE=MSB
# API key cấu hình trong SePay > Webhook (SePay gửi header "Authorization: Apikey <key>")
SEPAY_API_KEY=your-sepay-webhook-api-key

# SERVER CONFIGURATION
PORT=3000
# NODE_ENV=production   # bật chế độ nghiêm ngặt: lỗi CSDL được báo ra, tắt simulator, bắt buộc SEPAY_API_KEY
# ENABLE_SIMULATOR=true # bật /api/simulate-payment ở production (chỉ cho bản demo)
# ALLOW_MOCK_DB=true    # cho phép chạy Mock Store ở production khi chưa có Supabase (chỉ cho bản demo)
