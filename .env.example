# SUPABASE CONFIGURATION
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# SEPAY CONFIGURATION
SEPAY_ACCOUNT_NUMBER=96886693088500
SEPAY_BANK_CODE=MSB
SEPAY_API_KEY=your_sepay_api_key

# SERVER CONFIGURATION
PORT=3000

# ĐỐI SOÁT & HOÀN TIỀN (quy trình 3 tầng)
# Khóa đăng nhập trang nội bộ admin.html (CSKH / Kế toán / IT). BẮT BUỘC khi dùng Supabase.
ADMIN_KEY=
# Khóa webhook SePay (BẮT BUỘC khi dùng Supabase): SePay gửi header "Authorization: Apikey <khóa>"
SEPAY_WEBHOOK_KEY=
# (Tùy chọn) Vercel Cron gửi "Authorization: Bearer <CRON_SECRET>" khi gọi /api/cron
CRON_SECRET=
# DB_MODE=mock -> chạy thử bằng bộ nhớ trong, không đụng Supabase thật
DB_MODE=

# ĐĂNG NHẬP THÀNH VIÊN (lib/auth.js) - BẮT BUỘC khi dùng Supabase: chuỗi ngẫu nhiên dài >= 32 ký tự
AUTH_SECRET=

# EMAIL THÔNG BÁO (lib/mailer.js) - để trống thì chỉ ghi nhận, không gửi thật
RESEND_API_KEY=
# Địa chỉ gửi đã xác minh trên Resend, VD: Beta Cinemas <no-reply@ten-mien-cua-ban.vn>
MAIL_FROM=
# Địa chỉ website để chèn link "Xem đơn hàng" trong email, VD: https://beta.example.vn
SITE_URL=

# SANDBOX THANH TOÁN (/api/simulate-payment) - chỉ dùng cho UAT. Mặc định TẮT khi chạy Supabase thật.
# Bật bằng ALLOW_SANDBOX=1 (vẫn phải gửi x-admin-key). KHÔNG bật trên production.
ALLOW_SANDBOX=
