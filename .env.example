# SUPABASE CONFIGURATION
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# SEPAY CONFIGURATION
SEPAY_ACCOUNT_NUMBER=96886693088500
SEPAY_BANK_CODE=MSB
SEPAY_API_KEY=your_sepay_api_key

# SERVER CONFIGURATION
PORT=3000

# ĐỐI SOÁT & HOÀN TIỀN (quy trình 3 tầng)
# Khóa dùng MỘT LẦN để tạo tài khoản Quản lý đầu tiên trên admin.html (sau đó mỗi người đăng nhập bằng tài khoản riêng).
ADMIN_KEY=
# Khóa webhook SePay (BẮT BUỘC khi dùng Supabase): SePay gửi header "Authorization: Apikey <khóa>"
SEPAY_WEBHOOK_KEY=
# BẮT BUỘC khi dùng Supabase: Vercel Cron gửi "Authorization: Bearer <CRON_SECRET>" khi gọi /api/cron
CRON_SECRET=
# DB_MODE=mock -> chạy thử bằng bộ nhớ trong, không đụng Supabase thật
DB_MODE=

# ĐĂNG NHẬP THÀNH VIÊN (lib/auth.js) - BẮT BUỘC khi dùng Supabase: chuỗi ngẫu nhiên dài >= 32 ký tự
AUTH_SECRET=

# EMAIL THÔNG BÁO (lib/mailer.js) - để trống thì chỉ ghi nhận, không gửi thật
RESEND_API_KEY=
# Địa chỉ gửi đã xác minh trên Resend, VD: Beta Cinemas <no-reply@ten-mien-cua-ban.vn>
MAIL_FROM=
# Địa chỉ website cho link "Xem đơn hàng" trong email, VD: https://beta.example.vn
# Chỉ cần khi chạy NGOÀI Vercel – trên Vercel web tự dùng tên miền production (VERCEL_PROJECT_PRODUCTION_URL)
SITE_URL=

# Ô "Tôi không phải robot" (Cloudflare Turnstile) cho form Hỗ trợ, Thuê rạp, Đăng ký, Quên mật khẩu (lib/turnstile.js).
# Tạo miễn phí: dash.cloudflare.com > Turnstile > Add widget (thêm tên miền web), chép Site Key + Secret Key.
# Để trống một trong hai -> tắt, form chạy như cũ.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SANDBOX THANH TOÁN (/api/simulate-payment) - chỉ dùng cho UAT. Mặc định TẮT khi chạy Supabase thật.
# Bật bằng ALLOW_SANDBOX=1 (vẫn phải đăng nhập tài khoản Quản lý). KHÔNG bật trên production.
ALLOW_SANDBOX=
