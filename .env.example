# SUPABASE (để trống -> chạy Mock Store, dữ liệu lưu tạm trong bộ nhớ)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# SEPAY
SEPAY_ACCOUNT_NUMBER=96886693088500
SEPAY_BANK_CODE=MSB
# API Key cấu hình ở webhook SePay; server kiểm tra header "Authorization: Apikey <key>"
SEPAY_API_KEY=your-sepay-api-key

# SERVER
PORT=3000
# Bật sandbox giả lập thanh toán trên môi trường production (mặc định tắt khi NODE_ENV=production)
# ALLOW_SIMULATE=1
