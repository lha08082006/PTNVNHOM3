{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/login", "destination": "/auth#login", "permanent": false },
    { "source": "/register", "destination": "/auth#register", "permanent": false }
  ]
}
